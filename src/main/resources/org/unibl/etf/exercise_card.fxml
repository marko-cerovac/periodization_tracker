         </font>
      </Label>
      <Label fx:id="descriptionLabel" text="Description" wrapText="true" />
      <Label fx:id="targetsLabel" text="Targets" textOverrun="CLIP" wrapText="true" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
